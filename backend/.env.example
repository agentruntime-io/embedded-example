# --- AgentRuntime BFF (localprod default) ---
# Base URL for all PAT-authenticated API calls. Production: https://api.agentruntime.io
AGENTRUNTIME_BFF_URL=http://localhost:8080

# --- Server-only PAT (never expose to browser or mobile app) ---
# Create in Console → Settings → API keys.
# Tier A connect-only demo: use template "Embedded Connect (connect only)" → mcp:read + mcp:write.
# Full embedded stack (connect + execute workflows): "Embedded Connect" adds workflow:run, mcp:execute.
AGENTRUNTIME_PAT=pat_your_token_here

# --- Partner webhook receiver (this FastAPI process) ---
# Public HTTPS URL where AgentRuntime POSTs connection.created (must match PUT /v1/embedded-connect/settings).
# Not used for OAuth — Google redirects to BFF /connect/callback, not this host.
DEMO_BACKEND_PUBLIC_URL=http://localhost:8090

# HMAC secret shared with AgentRuntime via embedded-connect settings.
# Must match the value in PUT /v1/embedded-connect/settings (demo registers on startup).
DEMO_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Comma-separated frontend origins for postMessage from BFF-hosted connect popup (your React app).
DEMO_FRONTEND_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Optional BFF config [embedded_connect] PUBLIC_BASE_URL if connect links must not use Host header.
# Default localprod hosted URL: http://localhost:8080/connect/s/{session_id}
